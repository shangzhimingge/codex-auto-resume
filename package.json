{
  "name": "codex-auto-resume",
  "version": "1.5.4",
  "description": "Automatically and safely resume Codex tasks after ChatGPT usage-window resets.",
  "type": "module",
  "bin": {
    "codex-auto-resume": "./bin/cli.mjs"
  },
  "files": [
    "bin/cli.mjs",
    "installer.py",
    "installer/__init__.py",
    "installer/codex_auto_resume_installer/*.py",
