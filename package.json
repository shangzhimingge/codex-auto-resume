    "README.zh-CN.md",
    "LICENSE",
    "RELEASE_NOTES.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "codex",
    "codex-skills",
    "agent-skills",
    "auto-resume",
    "ai-coding",
    "coding-agent",
    "chatgpt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/shangzhimingge/codex-auto-resume.git"
  },
